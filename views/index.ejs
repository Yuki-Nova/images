<%- include('partials/header', { title: '相册' }) %>

<main class="wrap">
    <header class="gallery-head">
        <h1 class="gallery-title">相册</h1>
        <p class="gallery-count" id="gallery-count"></p>
    </header>

    <nav class="filter-bar" id="filter-bar"></nav>

    <div class="grid" id="grid"></div>

    <div class="pagination" id="pagination">
        <button id="page-prev" type="button">上一页</button>
        <span id="page-info">0 / 0</span>
        <button id="page-next" type="button">下一页</button>
    </div>
</main>

<script id="gallery-data" type="application/json"><%- JSON.stringify(images.map(function(img){
    return {
        key: img.objectKey,
        name: img.name,
        url: img.url,
        thumb: img.thumbUrl,
        time: img.lastModified || ''
    };
})) %></script>

<div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" id="lb-close" type="button" aria-label="关闭">&times;</button>
    <button class="lightbox-nav prev" id="lb-prev" type="button" aria-label="上一张">&lsaquo;</button>
    <figure class="lightbox-stage">
        <img id="lb-img" src="" alt="预览">
        <figcaption class="lightbox-meta">
            <span class="meta-name" id="lb-name"></span>
            <span class="meta-sub" id="lb-sub"></span>
            <div class="meta-actions">
                <input id="lb-cat" type="text" placeholder="输入分类">
                <button id="lb-save-cat" type="button">保存分类</button>
                <button id="lb-copy" type="button">复制 Markdown</button>
                <a id="lb-orig" href="#" target="_blank" rel="noopener">原图</a>
            </div>
        </figcaption>
    </figure>
    <button class="lightbox-nav next" id="lb-next" type="button" aria-label="下一张">&rsaquo;</button>
    <p class="lightbox-hint">← → 切换 · Esc 关闭</p>
</div>

<%- include('partials/footer') %>
